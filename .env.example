# ===========================================================================
# LinkedIn Post Ghostwriter - Environment Variables
# ===========================================================================

# 1. Google Gemini API
# Get a key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# 2. Email Delivery
# Your Gmail address (used as both sender and recipient for draft review)
RECIPIENT_EMAIL=your_email@gmail.com
RECIPIENT_NAME=Henry

# 3. LinkedIn Profile & Optional Session Cookie
LINKEDIN_PROFILE_URL=https://www.linkedin.com/in/henryhyunwookim/
# Optional: li_at session cookie to bypass LinkedIn HTTP 999 authwall
# LINKEDIN_LI_AT=AQEDA...

# 4. Timezone & Schedule (Friday 9PM JST)
TIMEZONE=Asia/Tokyo
SCHEDULE=0 21 * * 5

# 5. Google Cloud Platform (for deployment)
GCP_PROJECT_ID=gen-lang-client-0480639565
GCP_REGION=asia-northeast1
SERVICE_NAME=linkedin-post-ghostwriter
JOB_NAME=linkedin-ghostwriter-weekly-trigger

# 6. Cloud Storage (for profile memory and operational run logs)
GCS_BUCKET_NAME=gen-lang-client-0480639565-linkedin-memory
GCS_MEMORY_BLOB=linkedin-ghostwriter/profile_memory.json
GCS_RUN_LOG_BLOB=linkedin-ghostwriter/run_log.json

# 7. Secret Manager (Shared Gmail OAuth token & cloud secrets)
SECRET_NAME=gmail-agent-token
SECRET_GEMINI_API_KEY=gemini-api-key
SECRET_GMAIL_CREDS=gmail-oauth-credentials
